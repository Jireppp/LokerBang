# Path ke file JSON Service Account Google Cloud
SERVICE_ACCOUNT_FILE=service_account.json

# ID Spreadsheet Google Sheets (ambil dari URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Nama worksheet/tab target (opsional, default: Job_Tracker)
SHEET_NAME=Job_Tracker
